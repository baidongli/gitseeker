[Unit]
Description=GitSeeker (Django + gunicorn)
After=network.target

[Service]
Type=simple
# 改成你 nginx 用的用户：CentOS/Alibaba 用 nginx，Ubuntu/Debian 用 www-data
User=root
WorkingDirectory=/opt/gitseeker
EnvironmentFile=/opt/gitseeker/.env
# systemd 自动创建 /run/gitseeker/，启动时存在，停止时清理
RuntimeDirectory=gitseeker
RuntimeDirectoryMode=0755
# 绑 Unix socket（不抢占端口）。--workers 数量按 CPU 调整: (2 × 核数) + 1
ExecStart=/usr/bin/gunicorn config.wsgi:application \
    --bind unix:/run/gitseeker/gunicorn.sock \
    --workers 2 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
