# 用 python3 -c "import secrets; print(secrets.token_urlsafe(50))" 生成
SECRET_KEY=

# 生产环境务必设为 False
DEBUG=False

# 用逗号分隔，必须包含你的服务器公网 IP 或域名
# 例如: ALLOWED_HOSTS=1.2.3.4
# 或:   ALLOWED_HOSTS=gitseeker.example.com,1.2.3.4
ALLOWED_HOSTS=

# 仅当用了反向代理或自定义域名时需要，格式带 scheme
# 例如: CSRF_TRUSTED_ORIGINS=http://1.2.3.4,https://gitseeker.example.com
CSRF_TRUSTED_ORIGINS=
